# McNutt Finance — environment template. Copy to the server's env file (see deploy/deploy.sh) and fill in secrets.
# Never commit real values. Lines marked [REQUIRED] must be set before go-live.

APP_NAME="McNutt Finance"
APP_ENV=production
APP_KEY=                                  # generated by deploy script on first run; back it up separately (encrypts secrets/tokens)
APP_DEBUG=false
APP_URL=https://invoices.mcnutt.cloud
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# MySQL 8 or MariaDB 10.6+. DB_CONNECTION=mysql works for both; use "mariadb" if you prefer the dedicated driver.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mcnutt_finance
DB_USERNAME=mcnutt_finance
DB_PASSWORD=                              # generated by deploy script on first run

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=__Host-mcfin_session       # host-only cookie (no Domain attribute)
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log                           # not used for client email; all mail goes through the notification service

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted. Leave empty when Apache terminates TLS itself.
TRUSTED_PROXIES=

# ---- McNutt Cloud authentication (docs/AUTH_INTEGRATION.md) ----
AUTH_DRIVER=mcnutt
AUTH_LOGIN_BASE=https://login.mcnutt.cloud
AUTH_APP_ID=                              # [REQUIRED] dedicated app id registered for this application
AUTH_APP_SECRET=                          # [REQUIRED] shared HMAC secret for that app id
AUTH_EXPECTED_ISSUER=https://login.mcnutt.cloud
AUTH_VALIDATE_ENDPOINT=https://login.mcnutt.cloud/api/validate.php
# Redirect shapes used by the official client helper ({login_base} {app_id} {return_url} {token}).
AUTH_LOGIN_URL_TEMPLATE="{login_base}/?return_url={return_url}&app_id={app_id}"
AUTH_LOGOUT_URL_TEMPLATE="{login_base}/logout_confirm.php?token={token}&return_url={return_url}"
AUTH_REVALIDATE_SECONDS=300
AUTH_CALLBACK_MAX_AGE_SECONDS=300
AUTH_VALIDATE_ON_CALLBACK=true
AUTH_EMAIL_IS_VERIFIED=false              # true only if McNutt Cloud guarantees verified emails
AUTH_BUSINESS_CREATION=all                # all | mapped (requires a central role mapping to businesses.create)
FINANCE_PLATFORM_ADMINS=                  # central principal ids allowed to manage platform role mappings

# ---- McNutt Cloud notifications (docs/INTEGRATIONS.md) ----
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_DRIVER=mcnutt
NOTIFICATIONS_BASE_URL=https://notifications.mcnutt.cloud
NOTIFICATIONS_API_TOKEN=                  # [REQUIRED] server-side bearer token
NOTIFICATIONS_FROM_EMAIL=                 # [REQUIRED] approved sender, e.g. billing@mcnutt.cloud
NOTIFICATIONS_APPROVED_SENDERS=           # optional comma list of additional approved sender addresses
NOTIFICATIONS_PROVIDER=                   # optional, e.g. "Twilio Email (SendGrid)"

# ---- Storage, cron, backups ----
FINANCE_PRIVATE_STORAGE=/var/lib/mcnutt-finance/private
FINANCE_MAX_UPLOAD_KB=10240
FINANCE_OUTBOX_BATCH=25
FINANCE_RECURRING_BATCH=50
FINANCE_CRON_MAX_SECONDS=50
FINANCE_BACKUP_STATUS_FILE=/var/lib/mcnutt-finance/backup-status.json
